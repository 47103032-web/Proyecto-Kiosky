# ---------------------------------------------------------------------
# Configuracion del backend Kiosky
# Copiar este archivo como .env y ajustar los valores.
# ---------------------------------------------------------------------

PORT=4000

# Origen permitido para CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173

# Secreto para firmar los tokens JWT. CAMBIAR en cualquier entorno real.
JWT_SECRET=kiosky-secreto-de-desarrollo
JWT_EXPIRES_IN=8h

# --------------------------- Base de datos ---------------------------
# Si MySQL no esta disponible, el backend arranca igual usando un
# repositorio en memoria con el mismo juego de datos que database/seed.sql.
# Para forzar el modo memoria sin intentar conectar: DB_MODE=memory
DB_MODE=auto
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kiosky

# Dias de anticipacion para considerar un producto "proximo a vencer"
DIAS_PROXIMO_VENCIMIENTO=30

# Bloque para /etc/caddy/Caddyfile del servidor. Caddy corre como servicio
# del sistema y resuelve el certificado solo; la API escucha en
# 127.0.0.1:8003 y nunca queda expuesta de forma directa.
#
# Mismo esquema que api-stockarg.aaronbrumat.com.ar.

api-kiosky.aaronbrumat.com.ar {
	encode zstd gzip

	reverse_proxy 127.0.0.1:8003

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
